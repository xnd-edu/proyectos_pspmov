### ===================================
### GUÍA RÁPIDA - TESTS JWT
### ===================================
#
# Este archivo contiene tests rápidos para probar
# todas las funcionalidades JWT de forma ordenada
#
### ===================================

@baseUrl = http://localhost:8080

### ===================================
### PARTE 1: AUTENTICACIÓN BÁSICA JWT
### ===================================

### 1️⃣ Login y obtener tokens
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "juan",
  "password": "juan123"
}

> {%
  client.global.set("accessToken", response.body.tokens.accessToken);
  client.global.set("refreshToken", response.body.tokens.refreshToken);
  client.log("✅ Tokens obtenidos");
%}

###

### 2️⃣ Validar token
GET {{baseUrl}}/token/validate?username=juan
Authorization: Bearer {{accessToken}}

###

### 3️⃣ Acceder a recurso protegido
GET {{baseUrl}}/api/user/renos
Authorization: Bearer {{accessToken}}

###

### 4️⃣ Refrescar token
POST {{baseUrl}}/token/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
  client.log("✅ Tokens refrescados");
%}

###

### ===================================
### PARTE 2: CONTROL DE ACCESO POR ROL
### ===================================

### 5️⃣ Login como admin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
  client.global.set("adminToken", response.body.tokens.accessToken);
%}

###

### 6️⃣ Admin accede a endpoint de admin ✅
GET {{baseUrl}}/api/admin/renos
Authorization: Bearer {{adminToken}}

###

### 7️⃣ Usuario intenta acceder a endpoint de admin ❌
GET {{baseUrl}}/api/admin/renos
Authorization: Bearer {{accessToken}}

> {%
  client.test("Usuario rechazado en endpoint admin", function() {
    client.assert(response.status === 403, "Forbidden");
  });
%}

###

### ===================================
### PARTE 3: HABILITAR 2FA
### ===================================

### 8️⃣ Habilitar 2FA TOTP
POST {{baseUrl}}/2fa/enable?method=TOTP
Authorization: Bearer {{accessToken}}

> {%
  client.global.set("totpSecret", response.body.secret);
  client.log("📱 Secret TOTP: " + response.body.secret);
  client.log("📱 QR Code: " + response.body.qrCodeUrl);
  client.log("⚠️ Escanea el QR con Google Authenticator");
%}

###

### 9️⃣ Confirmar 2FA (ingresa el código de tu app)
POST {{baseUrl}}/2fa/confirm
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "code": "184535"
}

> {%
  client.log("✅ 2FA activado. Ahora todos los logins requieren código");
%}

###

### ===================================
### PARTE 4: LOGIN CON 2FA
### ===================================

### 🔟 Login con usuario que tiene 2FA
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "juan",
  "password": "juan123"
}

> {%
  client.global.set("preToken", response.headers.valueOf("X-PreToken"));
  client.log("⏳ Pre-token recibido (válido 5 min)");
  client.log("🔐 Pre-token: " + response.headers.valueOf("X-PreToken"));
%}

###

### 1️⃣1️⃣ Verificar 2FA para completar login
POST {{baseUrl}}/2fa/verify
Content-Type: application/json
Authorization: Bearer {{preToken}}

{
  "code": "385573"
}

> {%
  client.global.set("accessToken", response.body.tokens.accessToken);
  client.global.set("refreshToken", response.body.tokens.refreshToken);
  client.log("✅ Login con 2FA completado - Tokens finales obtenidos");
%}

###

### ===================================
### PARTE 5: CASOS DE ERROR
### ===================================

### 1️⃣2️⃣ Login con credenciales incorrectas
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "juan",
  "password": "wrong_password"
}

> {%
  client.test("Credenciales incorrectas rechazadas", function() {
    client.assert(response.status === 403, "Forbidden");
  });
%}

###

### 1️⃣3️⃣ Acceder sin token
GET {{baseUrl}}/api/user/renos

> {%
  client.test("Sin token rechazado", function() {
    client.assert(response.status === 401, "Unauthorized");
  });
%}

###

### 1️⃣4️⃣ Token inválido
GET {{baseUrl}}/api/user/renos
Authorization: Bearer invalid.token.here

> {%
  client.test("Token inválido rechazado", function() {
    client.assert(response.status === 401, "Unauthorized");
  });
%}

###

### 1️⃣5️⃣ Código 2FA incorrecto
POST {{baseUrl}}/2fa/verify
Content-Type: application/json
Authorization: Bearer {{preToken}}

{
  "code": "000000"
}

> {%
  client.test("Código 2FA incorrecto rechazado", function() {
    client.assert(response.status === 403, "Forbidden");
  });
%}

###

### ===================================
### RESUMEN DE ENDPOINTS
### ===================================
#
# AUTENTICACIÓN:
# - POST /login                    → Obtener tokens JWT
# - POST /logout                   → Logout (cliente borra tokens)
# - POST /register                 → Registrar nuevo usuario
#
# TOKENS:
# - GET  /token/validate             → Validar token (testing)
# - POST /token/refresh              → Refrescar tokens
#
# 2FA SETUP:
# - POST /2fa/enable?method={tipo} → Habilitar 2FA (TOTP|EMAIL)
# - POST /2fa/confirm              → Confirmar/activar 2FA
#
# 2FA LOGIN:
# - POST /2fa/verify               → Verificar código 2FA
#
# RECURSOS:
# - GET  /api/user/renos           → Renos del usuario (USER)
# - GET  /api/admin/renos          → Todos los renos (ADMIN)
#
### ===================================

### ===================================
### FLUJOS PRINCIPALES
### ===================================
#
# FLUJO 1: Login Simple (sin 2FA)
# 1. POST /login → Recibe tokens
# 2. GET /api/user/renos (con token) → Accede a recursos
#
# FLUJO 2: Login con 2FA
# 1. POST /login → Recibe pre-token (202 Accepted)
# 2. POST /2fa/verify (con pre-token) → Recibe tokens finales
# 3. GET /api/user/renos (con token final) → Accede a recursos
#
# FLUJO 3: Habilitar 2FA
# 1. POST /login → Obtener token
# 2. POST /2fa/enable?method=TOTP → Recibe secret y QR
# 3. Escanear QR con app
# 4. POST /2fa/confirm (con código) → Activa 2FA
# 5. POST /logout
# 6. Desde ahora, todos los logins requieren 2FA
#
# FLUJO 4: Refresh Token
# 1. POST /token/refresh (con refresh token)
# 2. Recibe nuevos access y refresh tokens
#
### ===================================

