### ============================================================
### TEST: CASO DE USO 1 - CREAR SECRETO CIFRADO SIMÉTRICAMENTE
###
### Flujo:
###   1. Registrar usuario Alice con par de claves RSA
###   2. Login de Alice → obtener JWT
###   3. Alice crea un secreto → cifrado con PBKDF2 + AES-GCM
###
### El servidor simula lo que haría el cliente Android:
###   - Genera salt aleatorio
###   - Deriva clave AES-256 con PBKDF2(password + salt)
###   - Cifra el texto plano con AES-GCM
###   - Guarda (encryptedData, iv, salt) en vault_secrets
### ============================================================

### ── PASO 1: Registrar Alice con su clave pública RSA ──────────
# La clave pública debe estar en formato X.509 codificada en Base64.
# Genera el par con KeyPairGeneratorApp y pega aquí la clave pública.
# El servidor la firmará y devolverá serverSignatureBase64 (certificado).
# @name registerAlice
POST http://localhost:8080/register/noactivation
Content-Type: application/json

{
  "username": "alice_secrets",
  "password": "AlicePass123!",
  "email": "alice_secrets@test.com",
  "nombre": "Alice",
  "publicKeyBase64": ""
}

> {%
  client.test("Alice registrada correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.success === true, "success debe ser true");
    client.assert(response.body.usuario !== null, "Debe devolver el usuario");
    client.assert(response.body.serverSignatureBase64 !== null,
        "Debe devolver la firma del servidor (certificado de la clave pública)");
  });

  client.global.set("alice_id", response.body.usuario.id);
%}

###

### ── PASO 2: Login de Alice ────────────────────────────────────
# @name loginAlice
POST http://localhost:8080/login
Content-Type: application/json

{
  "username": "alice_secrets",
  "password": "AlicePass123!"
}

> {%
  client.test("Alice logueada correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.tokens !== null, "Debe devolver tokens JWT");
    client.assert(response.body.tokens.accessToken !== null, "Debe devolver accessToken");
  });

  client.global.set("alice_token", response.body.tokens.accessToken);
%}

###

### ── PASO 3: Alice crea su secreto (simulación del cliente Android) ──
# El servidor simula el cifrado punto a punto:
#   - Genera salt aleatorio
#   - Deriva clave AES con PBKDF2(password + salt)
#   - Cifra plainText con AES-GCM
#   - Guarda en vault_secrets
# @name createSecret
POST http://localhost:8080/api/simulation/create-secret
Content-Type: application/json
Authorization: Bearer {{alice_token}}

{
  "plainText": "Mi contraseña del banco: 1234-5678-abcd",
  "password": "AlicePass123!"
}

> {%
  client.test("Secreto creado y cifrado correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.id !== null, "Debe devolver el ID del secreto en BD");
    client.assert(response.body.createdAt !== null, "Debe devolver la fecha de creación");
  });

  client.global.set("alice_secret_id", response.body.id);
%}

###

### ── VERIFICACIÓN: El secreto aparece en GET /api/secrets ─────
# Comprueba que el secreto se guardó correctamente en vault_secrets
# @name getSecrets
GET http://localhost:8080/api/secrets
Authorization: Bearer {{alice_token}}

> {%
  client.test("El secreto aparece en el vault del usuario", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.length > 0, "Alice debe tener al menos un secreto");
    const secret = response.body.find(s => s.id == client.global.get("alice_secret_id"));
    client.assert(secret !== undefined, "El secreto creado debe estar en la lista");
    client.assert(secret.encryptedData !== null, "El secreto debe tener datos cifrados");
    client.assert(secret.iv !== null, "El secreto debe tener IV");
    client.assert(secret.salt !== null, "El secreto debe tener salt");
  });
%}

###

### ── VERIFICACIÓN: Descifrar el secreto guardado (simulación) ──
# El servidor descifra el secreto usando la contraseña y devuelve el texto plano
# @name decryptSecret
POST http://localhost:8080/api/simulation/decrypt-secret/{{alice_secret_id}}
Content-Type: application/json
Authorization: Bearer {{alice_token}}

{
  "password": "AlicePass123!"
}

> {%
  client.test("El secreto se descifra correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.plainText === "Mi contraseña del banco: 1234-5678-abcd", "El texto plano debe coincidir");
  });
%}

###

### ── LIMPIEZA: Eliminar el secreto ────────────────────────────
# @name deleteSecret
DELETE http://localhost:8080/api/secrets/{{alice_secret_id}}
Authorization: Bearer {{alice_token}}

> {%
  client.test("Secreto eliminado correctamente", function() {
    client.assert(response.status === 204, "Status debe ser 204 No Content");
  });
%}
