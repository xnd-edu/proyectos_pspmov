### ============================================================
### TEST: CASO DE USO 2 - COMPARTIR SECRETO (CIFRADO PUNTO A PUNTO)
###
### Flujo:
###   1. Registrar Alice (propietaria) con clave pública RSA
###   2. Registrar Bob (receptor) con clave pública RSA
###   3. Login de Alice → obtener JWT
###   4. Alice crea un secreto cifrado con su contraseña
###   5. Alice comparte el secreto con Bob (simulación del cliente Android)
###   6. Verificar que Bob puede ver el secreto compartido
###   7. (Limpieza) Alice revoca el secreto compartido
###
### El servidor simula lo que haría el cliente Android en el paso 5:
###   - Descifra el secreto con la contraseña de Alice (PBKDF2 + AES-GCM)
###   - Verifica la firma del servidor sobre la clave pública de Bob (certificado) para asegurarse que es válida
###   - Genera una clave AES aleatoria nueva
###   - Cifra el texto plano con la nueva clave AES-GCM
###   - Obtiene la clave pública RSA de Bob (GET /api/public-keys/{username})
###   - Cifra la clave AES con la clave pública de Bob (RSA-OAEP)
###   - Guarda (secretId, encryptedData, encryptedKey, iv) en shared_secrets
### ============================================================

### ── PASO 1: Registrar Alice (propietaria del secreto) ────────
# @name registerAlice
POST http://localhost:8080/register/noactivation
Content-Type: application/json

{
  "username": "alice_share",
  "password": "AlicePass123!",
  "email": "alice_share@test.com",
  "nombre": "Alice",
  "publicKeyBase64": ""
}

> {%
  client.test("Alice registrada correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.success === true, "success debe ser true");
    client.assert(response.body.serverSignatureBase64 !== null,
        "Alice debe recibir la firma del servidor sobre su clave pública");
  });

  client.global.set("alice_share_id", response.body.usuario.id);
%}

###

### ── PASO 2: Registrar Bob (receptor del secreto) ─────────────
# Bob debe tener su par de claves RSA registrado para recibir secretos.
# Su clave pública debe ser DIFERENTE a la de Alice.
# @name registerBob
POST http://localhost:8080/register/noactivation
Content-Type: application/json

{
  "username": "bob_share",
  "password": "BobPass123!",
  "email": "bob_share@test.com",
  "nombre": "Bob",
  "publicKeyBase64": ""
}

> {%
  client.test("Bob registrado correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.success === true, "success debe ser true");
    client.assert(response.body.serverSignatureBase64 !== null,
        "Bob debe recibir la firma del servidor sobre su clave pública");
  });

  client.global.set("bob_share_id", response.body.usuario.id);
%}

###

### ── PASO 3: Login de Alice ────────────────────────────────────
# @name loginAlice
POST http://localhost:8080/login
Content-Type: application/json

{
  "username": "alice_share",
  "password": "AlicePass123!"
}

> {%
  client.test("Alice logueada correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.tokens !== null, "Debe devolver tokens JWT");
  });

  client.global.set("alice_share_token", response.body.tokens.accessToken);
%}

###

### ── PASO 4: Alice crea su secreto ───────────────────────────
# Primero Alice crea el secreto en su vault cifrado con su contraseña.
# @name createSecret
POST http://localhost:8080/api/simulation/create-secret
Content-Type: application/json
Authorization: Bearer {{alice_share_token}}

{
  "plainText": "Contraseña super secreta: P@ss_B4nk_2025!",
  "password": "AlicePass123!"
}

> {%
  client.test("Secreto creado correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.id !== null, "Debe devolver el ID del secreto");
    client.assert(response.body.createdAt !== null, "Debe devolver la fecha de creación");
  });

  client.global.set("shared_secret_original_id", response.body.id);
%}

###

### ── PASO 5: Alice comparte el secreto con Bob (simulación E2E) ──
# El servidor simula el cifrado punto a punto:
#   1. Descifra el secreto de Alice con su contraseña
#   2. Genera clave AES aleatoria nueva
#   3. Cifra el texto plano con AES-GCM
#   4. Obtiene la clave pública RSA de Bob via GET /api/public-keys/bob_share
#   5. Cifra la clave AES con la clave pública de Bob (RSA-OAEP)
#   6. Guarda en shared_secrets
# @name shareSecret
POST http://localhost:8080/api/simulation/share-secret
Content-Type: application/json
Authorization: Bearer {{alice_share_token}}

{
  "secretId": {{shared_secret_original_id}},
  "recipientUserId": {{bob_share_id}},
  "ownerPassword": "AlicePass123!",
  "serverPublicKeyBase64": ""
}

> {%
  client.test("Secreto compartido correctamente con Bob", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.id !== null, "Debe devolver el ID del secreto compartido en BD");
    client.assert(response.body.sharedWithId !== null, "Debe devolver el ID del receptor");
    client.assert(response.body.createdAt !== null, "Debe devolver la fecha de creación");
  });
%}

###

### ── PASO 6: Login de Bob ──────────────────────────────────────
# @name loginBob
POST http://localhost:8080/login
Content-Type: application/json

{
  "username": "bob_share",
  "password": "BobPass123!"
}

> {%
  client.test("Bob logueado correctamente", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.tokens !== null, "Debe devolver tokens JWT");
  });

  client.global.set("bob_share_token", response.body.tokens.accessToken);
%}

###

### ── PASO 7: Bob consulta los secretos que le han compartido ──
# Bob ve todos los secretos compartidos con él.
# Los datos están cifrados — en la app real Bob los descifraría con su clave privada RSA.
# @name getSharedSecrets
GET http://localhost:8080/api/secrets/share
Authorization: Bearer {{bob_share_token}}

> {%
  client.test("Bob puede ver los secretos compartidos con él", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.length > 0, "Bob debe tener al menos un secreto compartido");
    const shared = response.body.find(s => s.id == client.global.get("shared_secret_id"));
    client.assert(shared !== undefined, "El secreto compartido por Alice debe estar en la lista");
    client.assert(shared.encryptedData !== null, "Debe contener los datos cifrados");
    client.assert(shared.encryptedKey !== null,
        "Debe contener la clave AES cifrada con la clave pública de Bob");
    client.assert(shared.iv !== null, "Debe contener el IV");
  });
%}

###

### ── PASO 8: Bob consulta el secreto compartido por ID ────────
# @name getSharedSecretById
GET http://localhost:8080/api/secrets/share/{{shared_secret_original_id}}
Authorization: Bearer {{bob_share_token}}

> {%
  client.test("Bob puede ver el secreto compartido por ID", function() {
    client.assert(response.status === 200, "Status debe ser 200");
    client.assert(response.body.id == client.global.get("shared_secret_id"),
        "El ID debe coincidir");
    client.assert(response.body.encryptedData !== null, "Debe contener los datos cifrados");
    client.assert(response.body.encryptedKey !== null,
        "Debe contener la clave AES cifrada con la clave pública de Bob");
  });
%}

###

### ── ERROR: Bob no puede revocar el secreto de Alice ──────────
# Solo el propietario puede revocar. Bob debe recibir 403.
# (Ejecutar antes de la limpieza si se quiere probar este caso)
# @name revokeSharedSecretForbidden
DELETE http://localhost:8080/api/secrets/share/{{shared_secret_original_id}}
Authorization: Bearer {{bob_share_token}}

> {%
    client.test("Bob no puede revocar un secreto que no es suyo", function() {
        client.assert(response.status === 403, "Status debe ser 403 Forbidden");
    });
%}

###

### ── LIMPIEZA: Alice revoca el secreto compartido ─────────────
# Solo el propietario (Alice) puede revocar un secreto compartido.
# @name revokeSharedSecret
DELETE http://localhost:8080/api/secrets/share/{{shared_secret_original_id}}
Authorization: Bearer {{alice_share_token}}

> {%
    client.test("Secreto compartido revocado correctamente", function() {
        client.assert(response.status === 204, "Status debe ser 204 No Content");
    });
%}
