<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/cochesMainFragment">

    <fragment
        android:id="@+id/cochesMainFragment"
        android:name="com.example.navigation.ui.games.main.GamesMainFragment"
        android:label="@string/titulo_juegos"
        tools:layout="@layout/fragment_games_main" >
    </fragment>
    <fragment
        android:id="@+id/conductoresMainFragment"
        android:name="com.example.navigation.ui.jsonplaceholder.main.JsonPlaceholderMainFragment"
        android:label="@string/titulo_posts"
        tools:layout="@layout/fragment_posts_main" >
        <action
            android:id="@+id/action_jsonPlaceholderMainFragment_to_jsonPlaceholderEditFragment"
            app:destination="@id/conductoresEditFragment" />
        <action
            android:id="@+id/action_jsonPlaceholderMainFragment_to_jsonPlaceholderAddFragment"
            app:destination="@id/conductoresAddFragment" />
    </fragment>
    <fragment
        android:id="@+id/conductoresEditFragment"
        android:name="com.example.navigation.ui.jsonplaceholder.edit.JsonPlaceholderEditFragment"
        android:label="@string/titulo_editar_post"
        tools:layout="@layout/fragment_posts_edit" >
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/conductoresAddFragment"
        android:name="com.example.navigation.ui.jsonplaceholder.add.JsonPlaceholderAddFragment"
        android:label="@string/titulo_anadir_post"
        tools:layout="@layout/fragment_posts_add" />
</navigation>