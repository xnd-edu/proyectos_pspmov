<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/cochesMainFragment">

    <fragment
        android:id="@+id/cochesMainFragment"
        android:name="com.example.navigation.ui.coches.cochesmain.CochesMainFragment"
        android:label="fragment_coches_main"
        tools:layout="@layout/fragment_coches_main" >
        <action
            android:id="@+id/action_cochesMainFragment_to_cochesEditFragment"
            app:destination="@id/cochesEditFragment" />
        <action
            android:id="@+id/action_cochesMainFragment_to_cochesNewFragment"
            app:destination="@id/cochesNewFragment" />
    </fragment>
    <fragment
        android:id="@+id/conductoresMainFragment"
        android:name="com.example.navigation.ConductoresMainFragment"
        android:label="fragment_conductores_main"
        tools:layout="@layout/fragment_conductores_main" />
    <fragment
        android:id="@+id/cochesEditFragment"
        android:name="com.example.navigation.ui.coches.cochesedit.CochesEditFragment"
        android:label="fragment_coches_edit"
        tools:layout="@layout/fragment_coches_edit" >
        <argument
            android:name="matricula"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/cochesNewFragment"
        android:name="com.example.navigation.ui.coches.cochesnew.CochesNewFragment"
        android:label="fragment_coches_new"
        tools:layout="@layout/fragment_coches_new" />
</navigation>